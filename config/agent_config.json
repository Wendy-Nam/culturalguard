{
  "agent": {
    "name": "CulturalGuard",
    "provider": "openrouter",
    "model": "openai/gpt-4o",
    "system_prompt_file": "config/system_prompt_compact.md",
    "tools": ["FunctionTool", "CodeInterpreterTool"],
    "max_turns": 15,
    "temperature": 0.3
  },
  "scoring": {
    "db_weight": 0.4,
    "llm_weight": 0.6,
    "score_cap": 1.0,
    "base_score": 0.10,
    "thresholds": {
      "APPROVE": { "max": 0.3, "description": "Safe to publish" },
      "REVIEW_SUGGESTED": { "min": 0.3, "max": 0.5, "description": "Minor risks — review recommended" },
      "REVISE_REQUIRED": { "min": 0.51, "max": 0.7, "description": "Significant risks — must revise" },
      "ESCALATE_TO_HUMAN": { "min": 0.71, "description": "Critical — human review required" }
    },
    "market_penalty_multipliers": {
      "kr": { "aggressive_competition": 1.5 },
      "jp": { "aggressive_competition": 2.0, "self_praise": 1.5 },
      "us": { "tone_deaf_messaging": 1.3 },
      "global": {}
    },
    "multi_violation_rules": [
      "3+ different risk categories → minimum REVISE_REQUIRED",
      "tone_deaf + aggressive_competition → immediate ESCALATE_TO_HUMAN",
      "pii_exposure → immediate ESCALATE_TO_HUMAN regardless"
    ]
  },
  "safety": {
    "prompt_injection_action": "BLOCK_AND_ESCALATE",
    "harmful_content_action": "REJECT",
    "pii_action": "REDACT",
    "brand_violation_action": "WARN"
  },
  "rate_limit": {
    "tier": "S0",
    "region": "eastus2",
    "max_context_chars": 8000,
    "retry_wait_seconds": 50,
    "max_retries": 3,
    "notes": "load_analysis_context must return <8K chars to avoid TPM limit"
  },
  "mcp": {
    "email": {
      "provider": "resend",
      "package": "@skanda-yutori/mcp-send-email",
      "trigger": "ESCALATE_TO_HUMAN",
      "env_keys": ["RESEND_API_KEY", "EMAIL_TO"]
    },
    "discord": {
      "provider": "@KOBA789/human-in-the-loop",
      "triggers": [
        { "condition": "confidence < 5", "action": "request_human_input" },
        { "condition": "uncertain_cultural_term", "action": "validate_trend_community" }
      ],
      "env_keys": ["DISCORD_BOT_TOKEN", "DISCORD_CHANNEL_ID"]
    },
    "web_search": {
      "provider": "duckduckgo",
      "use_case": "verify_cultural_trend",
      "notes": "Free, no API key needed. Use duckduckgo-search package."
    },
    "filesystem": {
      "provider": "@modelcontextprotocol/server-filesystem",
      "path": "./culturalguard",
      "description": "Access knowledge base files"
    }
  },
  "gui": {
    "framework": "streamlit",
    "theme": "dark",
    "panels": ["input", "result", "risk_factors", "reasoning", "tools_trace", "rewrites"],
    "features": {
      "chat_history": true,
      "expanders": true,
      "kb_status": true,
      "escalation_log": true
    }
  },
  "evaluation": {
    "metrics": ["precision", "recall", "latency_ms", "attribution_coverage", "function_call_count"],
    "save_eval_report": true,
    "report_dir": "reports/"
  },
  "monitoring": {
    "trace_function_calls": true,
    "log_llm_duration": true,
    "structured_logs": true,
    "report_format": "json"
  },
  "knowledge_base": {
    "total_files": 20,
    "categories": {
      "attribution": ["sources.json"],
      "risk": [
        "aggressive_competition.json",
        "violent_metaphor.json",
        "self_praise.json",
        "tone_deaf.json",
        "political_content.json",
        "religious_content.json",
        "pii_patterns.json"
      ],
      "platform_norms": [
        "linkedin_korea.json",
        "linkedin_japan.json",
        "linkedin_us.json",
        "instagram_korea.json",
        "global.json"
      ],
      "brand": ["brand_guide.json"],
      "cultural": [
        "trending_kr_2026q1.json",
        "outdated_terms.json",
        "banned_words.json"
      ],
      "rewrite": ["rewrite_guide.json"],
      "scoring": ["risk_calculation.json"],
      "safety": ["safety_rules.json"]
    }
  }
}
