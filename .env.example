# CulturalGuard — Environment Variables Template
# Copy this file to .env and fill in your values

# ============================================================================
# OpenRouter Configuration (recommended for multi-provider models)
# ============================================================================

# OpenRouter API key
OPENROUTER_API_KEY=or_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenRouter base URL (default)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Default model (OpenRouter model ID)
OPENROUTER_MODEL=openai/gpt-4o

# ============================================================================
# Azure AI Foundry Configuration (optional)
# ============================================================================

# Project endpoint from Azure AI Foundry (found in your project overview)
PROJECT_ENDPOINT=your-project-endpoint-here

# Model deployment name (e.g., gpt-4o, gpt-5.1)
MODEL_DEPLOYMENT_NAME=gpt-4o

# ============================================================================
# MCP: Email (Resend) - for escalation emails
# ============================================================================

# Get your API key from https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Email recipient for escalations
EMAIL_TO=reviewer@yourcompany.com

# ============================================================================
# MCP: Slack - for human-in-the-loop
# ============================================================================

# Incoming webhook URL from Slack
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# ============================================================================
# Application Settings
# ============================================================================

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Save evaluation reports
SAVE_EVAL_REPORTS=true
